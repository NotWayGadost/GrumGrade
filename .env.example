# Скопируй этот файл в .env и заполни.

# Порт и публичный адрес сайта (на хостинге — https://твой-домен)
PORT=3000
BASE_URL=http://localhost:3000

# Ключ Steam Web API для ника и аватарки: https://steamcommunity.com/dev/apikey
# Вход через Steam работает и без него, просто ник будет "Player XXXX".
STEAM_API_KEY=

# 1 = демо: кнопка "Демо-вход" и бесплатное пополнение. На боевом сайте поставь 0.
DEMO_MODE=1

# SteamID64 админов через запятую (доступ к /api/admin/*)
ADMIN_STEAM_IDS=

# Экономика
UPGRADE_HOUSE_EDGE=0.10
UPGRADE_MAX_CHANCE=0.75
CASE_MARGIN=0.15

# Цены: источник Skinport (+ market.csgo.com как запасной). 1 монета = 1 единица валюты × множитель.
PRICE_CURRENCY=RUB
PRICE_MULTIPLIER=1
# Автообновление цен в часах (0 = выключить). Вручную: npm run prices
PRICE_UPDATE_HOURS=6
# Защита от кривых данных: если цена изменилась больше чем в N раз — не обновлять
PRICE_MAX_JUMP=10

# Файл базы (по умолчанию data/grumgrade.db)
# DB_FILE=

# Пароль админ-панели (/admin), минимум 6 символов. Пусто = панель выключена.
ADMIN_PASSWORD=

# Ссылка на Telegram, показывается в приложении (https://t.me/...)
TELEGRAM_URL=

# Ежедневный бонус в монетах (BONUS_MAX=0 — выключить)
BONUS_MIN=5
BONUS_MAX=50
BONUS_HOURS=24
